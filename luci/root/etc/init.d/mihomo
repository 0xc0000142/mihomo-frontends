#!/bin/sh /etc/rc.common
# mihomo（liuran001 smart + eBPF 分支），由 luci-app-mihomo-ebpf 提供。
# 内核与配置可在 LuCI「服务 → Mihomo」的「内核」「向导」页面安装与生成；缺少任一项时不启动，原因写入系统日志。
START=99
STOP=10
USE_PROCD=1

PROG=/usr/bin/mihomo-ebpf
HOME_DIR=/etc/mihomo

start_service() {
	if [ ! -x "$PROG" ]; then
		logger -t mihomo-ebpf "未安装内核 $PROG，请在 LuCI 的「内核」页面安装"
		return 1
	fi
	if [ ! -s "$HOME_DIR/config.yaml" ]; then
		logger -t mihomo-ebpf "缺少配置 $HOME_DIR/config.yaml，请在 LuCI 的「向导」页面生成"
		return 1
	fi
	procd_open_instance
	procd_set_param command "$PROG" -d "$HOME_DIR"
	procd_set_param respawn 3600 5 5
	procd_set_param limits nofile="65535 65535"
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

reload_service() {
	stop
	start
}
